# Convex
CONVEX_URL=https://your-deployment.convex.cloud
# For HTTP actions (auth routes). In production: https://your-deployment.convex.site
# For local dev: usually same as CONVEX_URL (e.g., http://127.0.0.1:3210)
CONVEX_SITE_URL=

# Better Auth (Required for authentication)
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (Optional - only configure what you need)
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
